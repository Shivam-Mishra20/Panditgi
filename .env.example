# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.panditgi.com

# Contact details shown across the site and used for call/WhatsApp links
NEXT_PUBLIC_PHONE_NUMBER=+91 98765 43210
# WhatsApp number MUST be in international format, digits only (no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_EMAIL=contact@panditgi.com

# Business location (shown in footer, contact page, and JSON-LD schema)
NEXT_PUBLIC_BUSINESS_CITY=Varanasi
NEXT_PUBLIC_BUSINESS_STATE=Uttar Pradesh
